{
    "name": "orangemoney-php/client",
    "description": "Orange Money PHP API client for supercharged interaction with Orange Money API",
    "keywords": [
        "php",
        "orange-money",
        "om",
        "sdk",
        "api",
        "client"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Dogbase",
            "email": "brunodogbase@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.30"
    },
    "autoload": {
        "psr-4": {
            "OrangeMoney\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OrangeMoney\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test:unit": "pest --colors=always",
        "test": [
            "@test:unit"
        ]
    }
}